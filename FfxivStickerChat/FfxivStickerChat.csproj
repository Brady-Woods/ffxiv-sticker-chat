<?xml version="1.0" encoding="utf-8"?>
<Project Sdk="Dalamud.NET.Sdk/15.0.0">
  <PropertyGroup>
    <!--
      Dalamud decides whether an update exists by comparing this number, so it must be bumped for every
      release even when the semver prerelease identifier on the tag already changed. A release that
      reuses it installs cleanly for new users and is invisible to existing ones.
    -->
    <Version>0.1.0.2</Version>
    <PackageProjectUrl>https://github.com/Brady-Woods/ffxiv-sticker-chat</PackageProjectUrl>
    <PackageLicenseExpression>AGPL-3.0-or-later</PackageLicenseExpression>
    <IsPackable>false</IsPackable>
    <!-- Required: we walk raw AtkResNode pointers inside _MiniTalk. -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="..\Data\stickers\**\*.png">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>stickers\%(RecursiveDir)%(Filename)%(Extension)</Link>
      <Visible>false</Visible>
    </Content>
  </ItemGroup>
</Project>
